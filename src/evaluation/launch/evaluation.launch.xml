<launch>
  <!-- Evaluation Package Launch File -->

  <!-- Evaluation Node -->
  <node
    pkg="evaluation"
    exec="evaluation_node"
    name="evaluation_node"
    output="screen">

    <!-- node parameters -->
    <param name="loop_rate_hz" value="8.0"/>

    <!-- Dynamic parameters-->
    <param name="mass" value="9.0877"/>
    
    <param name="inertia_xx" value="0.1454"/>
    <param name="inertia_yy" value="0.1366"/>
    <param name="inertia_zz" value="0.1594"/>
    <param name="inertia_xy" value="0.0"/>
    <param name="inertia_xz" value="0.0"/>
    <param name="inertia_yz" value="0.0"/>

    <param name="center_of_mass" value="[0.0, 0.0, 0.0]" />

  </node>
</launch>