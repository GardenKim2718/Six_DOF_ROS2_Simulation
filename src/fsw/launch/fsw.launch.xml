<launch>
  <!-- FSW Package Launch File -->

  <!-- Navigation Node -->
  <node
    pkg="fsw"
    exec="navigation_node"
    name="navigation_node"
    output="screen">

    <!-- node parameters -->
    <param name="loop_rate_hz" value="8.0"/>

  </node>

  <!-- Guidance Node -->
  <node
    pkg="fsw"
    exec="guidance_node"
    name="guidance_node"
    output="screen">

    <!-- node parameters -->
    <param name="loop_rate_hz" value="8.0"/>

    <!-- target parameters-->
    <param name="target_x" value="10.0"/>
    <param name="target_y" value="5.0"/>
    <param name="target_z" value="0.0"/>
    <param name="target_vx" value="0.0"/>
    <param name="target_vy" value="0.0"/>
    <param name="target_vz" value="0.0"/>

    <param name="target_qx" value="0.0"/>
    <param name="target_qy" value="0.0"/>
    <param name="target_qz" value="0.25882"/>
    <param name="target_qw" value="0.96593"/>
    <param name="target_wx" value="0.0"/>
    <param name="target_wy" value="0.0"/>
    <param name="target_wz" value="0.0"/>

    <!-- Dynamic Parameters -->
    <param name="mass" value="9.0877"/>
    
    <param name="inertia_xx" value="0.1454"/>
    <param name="inertia_yy" value="0.1366"/>
    <param name="inertia_zz" value="0.1594"/>
    <param name="inertia_xy" value="0.0"/>
    <param name="inertia_xz" value="0.0"/>
    <param name="inertia_yz" value="0.0"/>

    <!-- Hardware Limits -->
    <param name="max_force" value="1.0"/>
    <param name="max_torque" value="1.0"/>

    <!-- Guidance Gains -->
    <param name="angular_kp" value="0.8"/>
    <param name="angular_kd" value="0.16"/>

  </node>

  <!-- Control Node -->
  <node
    pkg="fsw"
    exec="control_node"
    name="control_node"
    output="screen">

    <!-- node parameters -->
    <param name="loop_rate_hz" value="8.0"/>

    <!-- Controller Gains -->
    <param name="linear_kp" value="0.16"/>
    <param name="linear_kd" value="0.8"/>
    <param name="linear_ki" value="0.0"/>

    <param name="angular_kp" value="0.8"/>
    <param name="angular_kd" value="0.16"/>
    <param name="angular_ki" value="0.0"/>

    <!-- Dynamic Parameters -->
    <param name="mass" value="9.0877"/>
    
    <param name="inertia_xx" value="0.1454"/>
    <param name="inertia_yy" value="0.1366"/>
    <param name="inertia_zz" value="0.1594"/>
    <param name="inertia_xy" value="0.0"/>
    <param name="inertia_xz" value="0.0"/>
    <param name="inertia_yz" value="0.0"/>

    <!-- Hardware Limits -->
    <param name="max_force" value="1.0"/>
    <param name="max_torque" value="1.0"/>
  </node>

  <!-- Actuator Node -->
  <node
    pkg="fsw"
    exec="actuator_node"
    name="actuator_node"
    output="screen">

    <!-- node parameters -->
    <param name="loop_rate_hz" value="8.0"/>

  </node>
</launch>